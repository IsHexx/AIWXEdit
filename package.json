{
    "name": "aiwxedit",
    "version": "1.0.6",
    "description": "Obsidian plugin for publishing notes to WeChat Official Account",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc --noEmit -skipLibCheck && node esbuild.config.mjs production",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "validate:release": "node scripts/validate-release.mjs",
        "check": "npm run lint && npm run build && npm run validate:release"
    },
    "keywords": [
        "obsidian",
        "wechat",
        "publishing"
    ],
    "author": "IsHexx",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/IsHexx/AIWXEdit.git"
    },
    "bugs": {
        "url": "https://github.com/IsHexx/AIWXEdit/issues"
    },
    "homepage": "https://github.com/IsHexx/AIWXEdit",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@eslint/json": "0.14.0",
        "@types/node": "^20.0.0",
        "builtin-modules": "^3.3.0",
        "esbuild": "0.28.2",
        "eslint": "9.39.5",
        "eslint-plugin-obsidianmd": "0.4.2",
        "obsidian": "1.8.7",
        "tslib": "^2.6.0",
        "typescript": "^5.3.0",
        "typescript-eslint": "8.72.0"
    },
    "dependencies": {
        "highlight.js": "^11.9.0",
        "html-to-image": "^1.11.11",
        "marked": "^12.0.1",
        "marked-highlight": "^2.1.3",
        "postcss": "8.5.31"
    },
    "overrides": {
        "moment": "^2.31.0"
    },
    "engines": {
        "node": ">=22"
    }
}
